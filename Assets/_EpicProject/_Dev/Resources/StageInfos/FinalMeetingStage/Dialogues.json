      "lines": [
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你"
          },
          "text": {
            "ko": "내 딸의 감정블럭... 영주가 그토록 원했던 것",
            "en": ".....",
            "zh-Hans": "....."
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你"
          },
          "text": {
            "ko": "하지만... 내 딸의 감정을 넘겨줄 순 없어",
            "en": ".....",
            "zh-Hans": "....."
          }
        }
      ]
    },

    {
      "id": "3_1_player",
      "lines": [
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你"
          },
          "text": {
            "ko": "딸에게 [감정 블럭]을 장착해주자.",
            "en": ".....",
            "zh-Hans": "....."
          }
        }
      ]
    },

    {
