{
  "dialogues": [
    {
      "id": "npc1_greeting",
      "lines": [
        {
          "speaker": {
            "ko": "나무꾼",
            "en": "Lumberjack",
            "zh-Hans": "樵夫"
          },
          "text": {
            "ko": "내 얘기 좀 들어주겠나?",
            "en": "Would you listen to my story?",
            "zh-Hans": "可以听我说几句吗？"
          }
        }
      ],
      "choices": [
        {
          "text": {
            "ko": "네 무슨일 있으신가요?",
            "en": "Yes, is there something wrong?",
            "zh-Hans": "好的，有什么事吗？"
          },
          "nextDialogueId": "npc1_info_town"
        },
        {
          "text": {
            "ko": "아니요 지금은 좀 바빠서..",
            "en": "Sorry, I'm a bit busy now...",
            "zh-Hans": "不好意思，我现在有点忙……"
          }
        }
      ]
    },
    {
      "id": "npc1_info_town",
      "lines": [
        {
          "speaker": {
            "ko": "나무꾼",
            "en": "Lumberjack",
            "zh-Hans": "樵夫"
          },
          "text": {
            "ko": "요즘 세상이 이상해진 거 알고 있나?",
            "en": "Did you notice the world is getting strange these days?",
            "zh-Hans": "你知道最近世界变得很奇怪吗？"
          }
        },
        {
          "speaker": {
            "ko": "나무꾼",
            "en": "Lumberjack",
            "zh-Hans": "樵夫"
          },
          "text": {
            "ko": "멀쩡하던 다리가 갑자기 끊어지고, 태양은 뒤틀려 있지. 그보다 나한테도 이상한 일이 벌어졌네!",
            "en": "Bridges suddenly collapse, the sun is twisted... But something strange happened to me too!",
            "zh-Hans": "好好的桥突然断了，太阳也扭曲了。更奇怪的是，我身上也发生了怪事！"
          }
        },
        {
          "speaker": {
            "ko": "나무꾼",
            "en": "Lumberjack",
            "zh-Hans": "樵夫"
          },
          "text": {
            "ko": "평소처럼 나무를 베다가 잠깐 쉬고 있었는데, 글쎄 <b><color=red>도끼</color></b>가 스스로 날아서 연못에 빠졌지 뭔가!",
            "en": "My <b><color=red>axe</color></b> suddenly flew into the pond while I was taking a break!",
            "zh-Hans": "像平时一样伐木休息的时候，<b><color=red>斧头</color></b>竟然自己飞进了池塘！"
          }
        }
      ]
    },
   
    {
      "id": "baldHead",
      "lines": [
        {
          "speaker": {
            "ko": "나무꾼",
            "en": "Lumberjack",
            "zh-Hans": "樵夫"
          },
          "text": {
            "ko": "악 눈부셔!",
            "en": "Ah! That's blinding!",
            "zh-Hans": "啊，好刺眼！"
          }
        }
      ]
    },
    {
      "id": "baldHead_Kid",
      "lines": [
        {
          "speaker": {
            "ko": "꼬마",
            "en": "Kid",
            "zh-Hans": "小孩"
          },
          "text": {
            "ko": "악 눈부셔!",
            "en": "Ah! That's blinding!",
            "zh-Hans": "啊，好刺眼！"
          }
        }
      ]
    },
    {
      "id": "npc_after_puzzle_A_solved",
      "lines": [
        {
          "speaker": {
            "ko": "나무꾼",
            "en": "Lumberjack",
            "zh-Hans": "樵夫"
          },
          "text": {
            "ko": "오! 연못이 다 말라버렸잖아?",
            "en": "Oh! The pond has completely dried up!",
            "zh-Hans": "哦！池塘都干了！"
          }
        },
        {
          "speaker": {
            "ko": "나무꾼",
            "en": "Lumberjack",
            "zh-Hans": "樵夫"
          },
          "text": {
            "ko": "도끼가 부러졌는데 어떻게 하냐고?",
            "en": "You're asking what to do about the broken axe?",
            "zh-Hans": "你问斧头断了怎么办？"
          }
        },
        {
          "speaker": {
            "ko": "나무꾼",
            "en": "Lumberjack",
            "zh-Hans": "樵夫"
          },
          "text": {
            "ko": "괜찮네! 나에겐 도끼가 없어도 독기는 있으니.. 후후",
            "en": "It's fine! Even if I don't have an axe, I still have my spirit... Hehe.",
            "zh-Hans": "没关系！即使没有斧头，我还有气势……呵呵。"
          }
        }
      ]
    },
    {
      "id": "NPC_02_default",
      "lines": [
        {
          "speaker": {
            "ko": "꼬마",
            "en": "Kid",
            "zh-Hans": "小孩"
          },
          "text": {
            "ko": "다리가 끊어져서 마을로 돌아갈 수가 없어..",
            "en": "The bridge is out, so I can't return to the village...",
            "zh-Hans": "桥断了，回不了村子……"
          }
        },
        {
          "speaker": {
            "ko": "꼬마",
            "en": "Kid",
            "zh-Hans": "小孩"
          },
          "text": {
            "ko": "<b><color=red>커다란 걸</color></b> 다리 중간에 놓을 수 있다면 건널 수 있을지도?",
            "en": "If we could put <b><color=red>something big</color></b> in the middle of the bridge, maybe we could cross?",
            "zh-Hans": "如果能在桥中间放<b><color=red>个大东西</color></b>，说不定就能过去了？"
          }
        }
      ]
    },
    {
      "id": "NPC_02_Flag01",
      "lines": [
        {
          "speaker": {
            "ko": "꼬마",
            "en": "Kid",
            "zh-Hans": "小孩"
          },
          "text": {
            "ko": "다리가 생겼잖아? 이제 집으로 돌아갈 수 있겠어!!",
            "en": "Look, a bridge has been made! Now I can go back home!!",
            "zh-Hans": "桥搭好了！这下可以回家了！！"
          }
        }
      ]
    },
    {
      "id": "intro_Player",
      "lines": [
        {
          "speaker": {
            "ko": "당신",
            "en": "Kid",
            "zh-Hans": "小孩"
          },
          "text": {
            "ko": "마침내 밖으로 나왔군. 그런데 여긴... 성으로 가는 절벽길인가.",
            "en": "Look, a bridge has been made! Now I can go back home!!",
            "zh-Hans": "桥搭好了！这下可以回家了！！"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "Kid",
            "zh-Hans": "小孩"
          },
          "text": {
            "ko": "저 다리... 영주가 버그를 일으켜 부서뜨려 놓은 게 틀림없어!",
            "en": "Look, a bridge has been made! Now I can go back home!!",
            "zh-Hans": "桥搭好了！这下可以回家了！！"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "Kid",
            "zh-Hans": "小孩"
          },
          "text": {
            "ko": "상관없어. 어떻게든 건너갈 방법을 찾고 말겠어.",
            "en": "Look, a bridge has been made! Now I can go back home!!",
            "zh-Hans": "桥搭好了！这下可以回家了！！"
          }
        }
      ]
    }
  ]
}
