    {
      "id": "Player_01",
      "lines": [
        {
          "speaker": {
            "ko": "당신",
            "en": "Flame Monster",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "이건 누구의 방이지..? 영주에게 딸이 있었나..? 그랬던 것 같기도하고 기억이 잘 안나네..",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "Flame Monster",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "그나저나.. 쓸만한게 없나?",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)"
          }
        }
      ]
    }
