      "lines": [
        {
          "speaker": {
            "ko": "고블린",
            "en": "Flame Monster",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "이게 다 저 빌어먹을 핀 때문이야... 도저히 쓰러지질 않는군! 킥킥!",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)"
          }
