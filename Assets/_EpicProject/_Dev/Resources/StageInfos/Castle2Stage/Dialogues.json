          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": ""
          },
          "text": {
            "ko": "...나의 불꽃이...",
            "en": "...My flame...",
            "zh-Hans": "……我的火焰……"
          }
