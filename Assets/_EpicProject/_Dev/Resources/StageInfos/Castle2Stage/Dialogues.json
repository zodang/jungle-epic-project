{
  "dialogues": [
    {
      "id": "stage_intro_Lord",
      "lines": [
        {
          "speaker": {
            "ko": "영주",
            "en": "Lord",
            "zh-Hans": "领主"
          },
          "text": {
            "ko": "너무 늦었다, 창조주여!",
            "en": "You're too late, Creator!",
            "zh-Hans": "太迟了，创造主！"
          }
        },
        {
          "speaker": {
            "ko": "영주",
            "en": "Lord",
            "zh-Hans": "领主"
          },
          "text": {
            "ko": "이제 내 딸은 완전한 감정을 되찾을 것이다!",
            "en": "Now, my daughter will finally regain her complete emotions!",
            "zh-Hans": "现在，我的女儿将重获完整的情感！"
          }
        }
      ]
    },
    {
      "id": "stage_intro_Player",
      "lines": [
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你"
          },
          "text": {
            "ko": "아직 늦지 않았어... 아니, 어떻게든 막아야 해.",
            "en": "It's not too late... No, I have to stop this, no matter what.",
            "zh-Hans": "还不晚……不，无论如何都要阻止。"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你"
          },
          "text": {
            "ko": "어떻게든 알현실 끝까지 뚫고 지나가야 해!",
            "en": "I have to break through to the end of the throne room, no matter what!",
            "zh-Hans": "无论如何都要突破到觐见室的尽头！"
          }
        }
      ]
    },
    {
      "id": "Fail_GuardBlock",
      "lines": [
        {
          "speaker": {
            "ko": "경비병",
            "en": "Guard",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "여기서 멈춰라. 영주님의 명에 따라, 이 앞으로는 한 발자국도 들일 수 없다!",
            "en": "Halt! Who goes there, trying to enter the Lord's castle without permission!",
            "zh-Hans": "站住！是谁胆敢擅自闯入领主的城堡！"
          }
        }
      ]
    },
    {
      "id": "Fail_FlameMonsterBlock",
      "lines": [
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": ""
          },
          "text": {
            "ko": "영주의... 분노가... 너를 태울 것이다...!",
            "en": "Halt! Who goes there, trying to enter the Lord's castle without permission!",
            "zh-Hans": "站住！是谁胆敢擅自闯入领主的城堡！"
          }
        }
      ]
    },
    {
      "id": "FlameMonster_Defeated",
      "lines": [
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": ""
          },
          "text": {
            "ko": "...아",
            "en": "...Ah",
            "zh-Hans": "……啊"
          }
        },
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": ""
          },
          "text": {
            "ko": "...나의 불꽃이...",
            "en": "...My flame...",
            "zh-Hans": "……我的火焰……"
          }
        },
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": ""
          },
          "text": {
            "ko": "(ﾟдﾟ　)",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)"
          }
        }
      ]
    },
    {
      "id": "FlameMonster_Defeated_Loop",
      "lines": [
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "(ﾟдﾟ　)",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)"
          }
        }
      ]
    },
    {
      "id": "Goblin_01",
      "lines": [
        {
          "speaker": {
            "ko": "고블린",
            "en": "Flame Monster",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "이게 다 저 빌어먹을 핀 때문이야... 도저히 쓰러지질 않는군! 킥킥!",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)"
          }
        }
      ]
    },
    {
      "id": "Player_01",
      "lines": [
        {
          "speaker": {
            "ko": "당신",
            "en": "Flame Monster",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "이건 누구의 방이지..? 영주에게 딸이 있었나..? 그랬던 것 같기도하고 기억이 잘 안나네..",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "Flame Monster",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "그나저나.. 쓸만한게 없나?",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)"
          }
        }
      ]
    },
    {
      "id": "FlameMonster_DestroyBall",
      "lines": [
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": "守卫"
          },
          "text": {
            "ko": "이런걸로 나를 어찌해볼 수 있는 줄 알았냐!!",
            "en": "You really thought that could stop me?!",
            "zh-Hans": "你以为这种东西就能对付我？！"
          }
        }
      ]
    }
  ]
}