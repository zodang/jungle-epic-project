{
  "dialogues": [
    {
      "id": "stage_intro_Lord",
      "lines": [
        {
          "speaker": {
            "ko": "영주",
            "en": "Lord",
            "zh-Hans": "领主",
            "ja": "領主",
            "zh-Hant": "領主"
          },
          "text": {
            "ko": "너무 늦었다, 창조주여!",
            "en": "You're too late, Creator!",
            "zh-Hans": "太迟了，创造主！",
            "ja": "遅かったな、創造主よ！",
            "zh-Hant": "太遲了，創造主！"
          }
        },
        {
          "speaker": {
            "ko": "영주",
            "en": "Lord",
            "zh-Hans": "领主",
            "ja": "領主",
            "zh-Hant": "領主"
          },
          "text": {
            "ko": "이제 내 딸은 완전한 감정을 되찾을 것이다!",
            "en": "Now, my daughter will finally regain her complete emotions!",
            "zh-Hans": "现在，我的女儿将重获完整的情感！",
            "ja": "これで我が娘は、失われた心を取り戻せるのだ！",
            "zh-Hant": "現在，我的女兒將重獲完整的情感！"
          }
        }
      ]
    },
    {
      "id": "stage_intro_Player",
      "lines": [
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你",
            "ja": "あなた",
            "zh-Hant": "你"
          },
          "text": {
            "ko": "아직 늦지 않았어... 아니, 어떻게든 막아야 해.",
            "en": "There’s still some time left, but I’m not just relying on hope — I’m determined to stop this.",
            "zh-Hans": "还不晚……不，我无论如何都要阻止。",
            "ja": "まだだ…まだ間に合う…！いや、何としてでも止める！",
            "zh-Hant": "還不晚……不，我無論如何都要阻止。"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你",
            "ja": "あなた",
            "zh-Hant": "你"
          },
          "text": {
            "ko": "어떻게든 알현실 끝까지 뚫고 지나가야 해!",
            "en": "I have to break through to the end of the throne room, no matter what!",
            "zh-Hans": "无论如何都要突破到觐见室的尽头！",
            "ja": "何としても、謁見室の奥まで突き進むんだ！",
            "zh-Hant": "無論如何都要突破到覲見室的盡頭！"
          }
        }
      ]
    },
    {
      "id": "Fail_GuardBlock",
      "lines": [
        {
          "speaker": {
            "ko": "경비병",
            "en": "Guard",
            "zh-Hans": "守卫",
            "ja": "衛兵",
            "zh-Hant": "守衛"
          },
          "text": {
            "ko": "여기서 멈춰라. 영주님의 명에 따라, 이 앞으로는 한 발자국도 들일 수 없다!",
            "en": "Halt! By order of the Lord, you may not take a single step further!",
            "zh-Hans": "站住！奉领主之命，任何人不得再前进一步！",
            "ja": "そこまでだ。領主様の御命令により、これより先へは一歩も通さん！",
            "zh-Hant": "站住！奉領主之命，任何人不得再前進一步！"
          }
        }
      ]
    },
    {
      "id": "Fail_FlameMonsterBlock",
      "lines": [
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": "火焰怪物",
            "ja": "炎の怪物",
            "zh-Hant": "火焰怪物"
          },
          "text": {
            "ko": "영주의... 분노가... 너를 태울 것이다...!",
            "en": "The Lord's... wrath... will burn you...!",
            "zh-Hans": "领主的……愤怒……将把你焚烧殆尽……！",
            "ja": "領主様の…怒りが…貴様を…焼き尽くす…！",
            "zh-Hant": "領主的……憤怒……將把你焚燒殆盡……！"
          }
        }
      ]
    },
    {
      "id": "FlameMonster_Defeated",
      "lines": [
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": "火焰怪物",
            "ja": "炎の怪物",
            "zh-Hant": "火焰怪物"
          },
          "text": {
            "ko": "...아",
            "en": "...Ah",
            "zh-Hans": "……啊",
            "ja": "…ぐっ",
            "zh-Hant": "……啊"
          }
        },
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": "火焰怪物",
            "ja": "炎の怪物",
            "zh-Hant": "火焰怪物"
          },
          "text": {
            "ko": "...나의 불꽃이...",
            "en": "...My flame...",
            "zh-Hans": "……我的火焰……",
            "ja": "…我が…炎が…",
            "zh-Hant": "……我的火焰……"
          }
        },
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": "火焰怪物",
            "ja": "炎の怪物",
            "zh-Hant": "火焰怪物"
          },
          "text": {
            "ko": "(ﾟдﾟ　)",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)",
            "ja": "(ﾟдﾟ　)",
            "zh-Hant": "(ﾟдﾟ　)"
          }
        }
      ]
    },
    {
      "id": "FlameMonster_Defeated_Loop",
      "lines": [
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": "火焰怪物",
            "ja": "炎の怪物",
            "zh-Hant": "火焰怪物"
          },
          "text": {
            "ko": "(ﾟдﾟ　)",
            "en": "(ﾟдﾟ　)",
            "zh-Hans": "(ﾟдﾟ　)",
            "ja": "(ﾟдﾟ　)",
            "zh-Hant": "(ﾟдﾟ　)"
          }
        }
      ]
    },
    {
      "id": "Goblin_01",
      "lines": [
        {
          "speaker": {
            "ko": "고블린",
            "en": "Goblin",
            "zh-Hans": "哥布林",
            "ja": "ゴブリン",
            "zh-Hant": "哥布林"
          },
          "text": {
            "ko": "볼링 치는데 방해하지 말라고!",
            "en": "Stop bothering me, I'm bowling!",
            "zh-Hans": "别打扰我打保龄球！",
            "ja": "ボウリングの邪魔すんじゃねえよ！",
            "zh-Hant": "別打擾我打保齡球！"
          }
        },
        {
          "speaker": {
            "ko": "고블린",
            "en": "Goblin",
            "zh-Hans": "哥布林",
            "ja": "ゴブリン",
            "zh-Hant": "哥布林"
          },
          "text": {
            "ko": "저 엄청나게 큰 볼링핀을 넘어뜨리고야 말겠어...",
            "en": "I'm going to knock down that giant bowling pin...",
            "zh-Hans": "我一定要把那个巨大的保龄瓶打倒……",
            "ja": "あのどでかいボウリングのピン、絶対に倒してやる…",
            "zh-Hant": "我一定要把那個巨大的保齡瓶打倒……"
          }
        }
      ]
    },
    {
      "id": "Player_01",
      "lines": [
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你",
            "ja": "あなた",
            "zh-Hant": "你"
          },
          "text": {
            "ko": "이건 누구의 방이지...?",
            "en": "Hmm... whose room was this...?",
            "zh-Hans": "嗯……这房间是谁的？",
            "ja": "この部屋は…誰の部屋だ…？",
            "zh-Hant": "嗯……這房間是誰的？"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你",
            "ja": "あなた",
            "zh-Hant": "你"
          },
          "text": {
            "ko": "영주에게 딸이 있었나...?",
            "en": "The lord had a daughter... didn’t he...?",
            "zh-Hans": "领主好像有个女儿……对吧？",
            "ja": "領主に娘がいた…け…？",
            "zh-Hant": "領主好像有個女兒……對吧？"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你",
            "ja": "あなた",
            "zh-Hant": "你"
          },
          "text": {
            "ko": "그랬던 것 같기도하고 기억이 잘 안나네...",
            "en": "I think so... but I don’t quite remember.",
            "zh-Hans": "好像是……不过我记不太清了。",
            "ja": "そんな気もするが…よく覚えていないな…",
            "zh-Hant": "好像是……不過我記不太清了。"
          }
        },
        {
          "speaker": {
            "ko": "당신",
            "en": "You",
            "zh-Hans": "你",
            "ja": "あなた",
            "zh-Hant": "你"
          },
          "text": {
            "ko": "그나저나... 쓸만한게 없나?",
            "en": "Anyway... is there anything useful here?",
            "zh-Hans": "话说回来……有什么能用的吗？",
            "ja": "それはそうと…何か使えるものはないか？",
            "zh-Hant": "話說回來……有什麼能用的嗎？"
          }
        }
      ]
    },
    {
      "id": "FlameMonster_DestroyBall",
      "lines": [
        {
          "speaker": {
            "ko": "화염 괴물",
            "en": "Flame Monster",
            "zh-Hans": "火焰怪物",
            "ja": "炎の怪物",
            "zh-Hant": "火焰怪物"
          },
          "text": {
            "ko": "이런걸로 나를 어찌해볼 수 있는 줄 알았냐!!",
            "en": "You really thought that could stop me?!",
            "zh-Hans": "你以为这种东西就能对付我？！",
            "ja": "こんな物で俺を止められるとでも思ったか！！",
            "zh-Hant": "你以為這種東西就能對付我？！"
          }
        }
      ]
    }
  ]
}