    {
      "id": "daughter_01",
      "lines": [
        {
          "speaker": {
            "ko": "딸",
            "en": "Daughter",
            "zh-Hans": "女儿",
            "ja": "娘",
            "zh-Hant": "女兒"
          },
          "text": {
            "ko": "저 언니 많이 아파..?",
            "en": "Is she very sick..?",
            "zh-Hans": "那个姐姐……病得很重吗？",
            "ja": "あのお姉ちゃん、だいじょうぶかな…？",
            "zh-Hant": "那個姐姐……病得很重嗎？"
          }
        }
      ]
    },
    {
      "id": "lord_01",
      "lines": [
        {
          "speaker": {
            "ko": "영주",
            "en": "Lord",
            "zh-Hans": "领主",
            "ja": "領主",
            "zh-Hant": "領主"
          },
          "text": {
            "ko": "정말로... 우리 딸을 도와줄 수 있다고?",
            "en": "Can you... really help my daughter?",
            "zh-Hans": "你真的……能帮助我的女儿？",
            "ja": "本当に…我が娘を助けることができるのか？",
            "zh-Hant": "你真的……能幫助我的女兒？"
          }
        }
      ]
    },
