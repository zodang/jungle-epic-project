{
  "dialogues": [
    {
      "id": "npc1_greeting",
      "lines": [
        {
          "speaker": "나무꾼",
          "text": "내 얘기 좀 들어주겠나?"
        }

      ],
      "choices": [
        {
          "text": "아니요 지금은 좀 바빠서.."
        },
        {
          "text": "네 무슨일 있으신가요?",
          "nextDialogueId": "npc1_info_town"
        }
      ]
    },
    {
      "id": "npc1_info_town",
      "lines": [
        {
          "speaker": "나무꾼",
          "text": "나무를 베다가 실수로 연못에 도끼를 빠뜨려버렸어.."
        },
        {
          "speaker": "나무꾼",
          "text": "나무를 너무 많이 베서 신께서 나를 나무라시는건가..."
        },
        {
          "speaker": "나무꾼",
          "text": "하하하 나무꾼 개그였네! 이 개그를 위해서 도끼도 빠뜨렸다네!"
        }
      ]
    },
    {
      "id": "npc1_farewell",
      "lines": [
        {
          "speaker": "경비원",
          "text": "그래, 조심해서 다니게."
        }
      ]
    },
    {
      "id": "npc2",
      "lines": [
        {
          "speaker": "나무꾼",
          "text": "나무를 베다가 실수로 도끼를 연못에 빠뜨려버렸어.."
        },
        {
          "speaker": "나무꾼",
          "text": "혹시 도끼를 찾아와 주지 않을래?"
        },
        {
          "speaker": "당신",
          "text": "알겠습니다."
        }
      ]
    },
    {
      "id": "baldHead",
      "lines": [
        {
          "speaker": "나무꾼",
          "text": "악 눈부셔!"
        }

      ]
    },
    {
      "id": "npc_after_puzzle_A_solved",
      "lines": [
        {
          "speaker": "나무꾼",
          "text": "오! 연못이 다 말라버렸잖아?"
        },
        {
          "speaker": "나무꾼",
          "text": "도끼는 어떻게 하냐고?"
        },
        {
          "speaker": "나무꾼",
          "text": "그건 너 알아서 해! 나에겐 도끼가 없어도 독기는 있으니.. 후후"
        }
      ]
    },
    {
      "id": "NPC_02_default",
      "lines": [
        {
          "speaker": "농부",
          "text": "다리가 끊어져서 마을로 돌아갈 수가 없어.."
        },
        {
          "speaker": "농부",
          "text": "<b><color=red>커다란 걸</color></b> 다리 중간에 놓을 수 있다면 건널 수 있을지도?"
        }
        
      ]
    }
  ]
}