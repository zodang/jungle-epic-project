{
  "dialogues": [
    {
      "id": "npc1_greeting",
      "lines": [
        {
          "speaker": "경비원",
          "text": "안녕하신가! 이 마을은 처음인가?"
        },
        {
          "speaker": "당신",
          "text": "네, 처음입니다."
        },
        {
          "speaker": "경비원",
          "text": "도움이 필요하면 언제든 말하게."
        }
      ],
      "choices": [
        {
          "text": "마을에 대해 알려주세요.",
          "nextDialogueId": "npc1_info_town"
        },
        {
          "text": "괜찮습니다.",
          "nextDialogueId": "npc1_farewell"
        }
      ]
    },
    {
      "id": "npc1_info_town",
      "lines": [
        {
          "speaker": "경비원",
          "text": "우리 마을은 평화롭고 아름다운 곳이지."
        },
        {
          "speaker": "당신",
          "text": "그렇군요!"
        }
      ]
    },
    {
      "id": "npc1_farewell",
      "lines": [
        {
          "speaker": "경비원",
          "text": "그래, 조심해서 다니게."
        }
      ]
    },
    {
      "id": "npc2",
      "lines": [
        {
          "speaker": "나무꾼",
          "text": "도끼를 연못에 빠뜨려버렸어.."
        },
        {
          "speaker": "나무꾼",
          "text": "혹시 도끼를 찾아와 주지 않을래?"
        },
        {
          "speaker": "당신",
          "text": "알겠습니다."
        }
      ]
    },
    {
      "id": "npc3",
      "lines": [
        {
          "speaker": "나무꾼",
          "text": "도끼를 연못에 빠뜨려버렸어.."
        },
        {
          "speaker": "나무꾼",
          "text": "혹시 도끼를 찾아와 주지 않을래?"
        },
        {
          "speaker": "나무꾼",
          "text": "나무나무나무 힘들다."
        }
