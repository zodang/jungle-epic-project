{
  "dialogues": [
    {
      "id": "npc1_greeting",
      "lines": [
        {
          "speaker": "NPC_Guard",
          "text": "안녕하신가! 이 마을은 처음인가?"
        },
        {
          "speaker": "Player",
          "text": "네, 처음입니다."
        },
        {
          "speaker": "NPC_Guard",
          "text": "도움이 필요하면 언제든 말하게."
        }
      ],
      "choices": [
        {
          "text": "마을에 대해 알려주세요.",
          "nextDialogueId": "npc1_info_town"
        },
        {
          "text": "괜찮습니다.",
          "nextDialogueId": "npc1_farewell"
        }
      ]
    },
    {
      "id": "npc1_info_town",
      "lines": [
        {
          "speaker": "NPC_Guard",
          "text": "우리 마을은 평화롭고 아름다운 곳이지."
        },
        {
          "speaker": "Player",
          "text": "그렇군요!"
        }
      ]
    },
    {
      "id": "npc1_farewell",
      "lines": [
        {
          "speaker": "NPC_Guard",
          "text": "그래, 조심해서 다니게."
        }
      ]
    }
  ]
}